# Optional. Without this key, sync reads public TBA team/match pages.
TBA_AUTH_KEY=
# Local storage; defaults to ./data.
AUTOSCOUT_DATA_DIR=./data
# No unlicensed team model weights are bundled.
# GPU whole-frame detection defaults to downloaded frc9550 YOLO26n weights.
# VISION_YOLO_MODEL=/absolute/path/to/custom-fuel-model.pt
# Automatic video worker; use one GPU at a time to keep memory bounded.
AUTOSCOUT_GPU_DEVICES=0
# Retry a failed match this many times before leaving it failed.
AUTOSCOUT_MAX_ATTEMPTS=3
